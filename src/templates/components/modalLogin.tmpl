{{define "modalLogin"}}<div class="modal fade" id="loginModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body">
                <h5 id="modalLoginTitle">Choose Your Wallet</h5>
                <div id="localWalletDiv" style="display: none;">
                    <button type="button" class="btn btn-primary btn-login-wallet" id="localWalletBtn">
                        <img class="wallet-logo yourplace-wallet-logo" src="/static/image/yourplace-logo.svg" alt="YourPlace Logo"/>
                        <span>YourPlace</span>
                    </button>
                    <div id="arrowToLocalWallet"></div>
                    <span id="noWalletHint">"I don't have a wallet"</span>
                </div>
                <button type="button" class="btn btn-primary btn-login-wallet" id="noWalletBtn">
                    <img class="wallet-logo yourplace-wallet-logo" src="/static/image/yourplace-logo.svg" alt="YourPlace Logo"/>
                    <span>I don't have a wallet</span>
                </button>
                <hr>
                <button type="button" class="btn btn-primary btn-login-wallet" id="coinbaseWalletBtn">
                    <img id="coinbaseImgModalLogin" class="wallet-logo" src="/static/image/base-square.svg" alt="Base App Logo"/>
                    <span>Base</span>
                </button>
                <button type="button" class="btn btn-primary btn-login-wallet" id="peraWalletBtn">
                    <img id="peraImgModalLogin" class="wallet-logo" src="/static/image/pera-small.png" alt="Pera Wallet Logo"/>
                    <span>Pera</span>
                </button>
                <button type="button" class="btn btn-primary btn-login-wallet" id="metaMaskWalletBtn">
                    <img id="metaMaskImgModalLogin" class="wallet-logo" src="/static/image/metamask.png" alt="MetaMask Wallet Logo"/>
                    <span>MetaMask</span>
                </button>
                <button type="button" class="btn btn-primary btn-login-wallet" id="phantomWalletBtn" disabled>
                    <img id="phantomImgModalLogin" class="wallet-logo" src="/static/image/phantom.svg" alt="Phantom Wallet Logo"/>
                    <span>Phantom</span>
                </button>
            </div>
        </div>
    </div>
</div>{{end}}