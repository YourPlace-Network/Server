{{define "modalProfileEdit"}}<div class="modal" id="modalProfileEdit" style="display:none;" tabindex="-1" aria-labelledby="modalProfileEditTitle">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalProfileEditTitle">Edit Profile</h5>
            </div>
            <div class="modal-body" id="modalProfileEditBody">
                <div id="editAvatar">
                    <label class="editLabel btn" for="inputAvatar">Upload Avatar</label>
                    <input type="file" class="form-control" id="inputAvatar" accept="image/png,image/jpeg,image/svg+xml,image/webp,image/gif"/>
                    <img id="avatarPreview" class="previewImg" src="/static/image/avatar.png" alt="avatar preview" crossorigin="anonymous" referrerpolicy="no-referrer">
                </div>
                <div id="editBanner">
                    <label class="editLabel btn" for="inputBanner">Upload Banner</label>
                    <input type="file" class="form-control" id="inputBanner" accept="image/png,image/jpeg,image/svg+xml,image/webp,image/gif"/>
                    <img id="bannerPreview" class="previewImg" src="/static/image/banner.jpg" alt="banner preview" crossorigin="anonymous" referrerpolicy="no-referrer">
                </div>

                <label class="editLabel" for="inputUsername">username</label><br>
                <div class="input-group mb-3 edit-profile-single-line-input">
                    <input type="text" class="form-control editInput" id="inputUsername" placeholder="Change Username" maxlength="100">
                    <button id="btnUsernameSave" class="btn btn-secondary edit-profile-save-btn" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Save" type="button"><i class="bi bi-save"></i></button>
                </div>

                <label class="editLabel" for="inputDescription">description</label>
                <div class="position-relative" id="inputDescriptionDiv">
                    <textarea class="form-control editInput" id="inputDescription" placeholder="Add Description" maxlength="200"></textarea>
                    <button id="btnDescriptionSave" class="btn btn-secondary edit-profile-save-btn" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Save" type="button"><i class="bi bi-save"></i></button>
                </div>

                <label class="editLabel" for="inputLocation">location</label>
                <div class="input-group mb-3 edit-profile-single-line-input">
                    <input type="text" class="form-control editInput" id="inputLocation" placeholder="Add Location" maxlength="50">
                    <button id="btnLocationSave" class="btn btn-secondary edit-profile-save-btn" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Save" type="button"><i class="bi bi-save"></i></button>
                </div>

                <label class="editLabel" for="inputWebsite">website</label>
                <div class="input-group mb-3 edit-profile-single-line-input">
                    <input type="url" class="form-control editInput" id="inputWebsite" placeholder="Add Website" maxlength="100">
                    <button id="btnWebsiteSave" class="btn btn-secondary edit-profile-save-btn" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Save" type="button"><i class="bi bi-save"></i></button>
                </div>

                <label class="editLabel" for="inputVertical">vertical</label>
                <div class="input-group mb-3 edit-profile-single-line-input">
                    <select class="form-select editInput" id="inputVertical">
                        <option value="">Select a Vertical</option>
                        <option value="anime">Anime</option>
                        <option value="art">Art</option>
                        <option value="asmr">ASMR</option>
                        <option value="automotive">Automotive</option>
                        <option value="beauty">Beauty</option>
                        <option value="books">Books</option>
                        <option value="business">Business</option>
                        <option value="career">Career</option>
                        <option value="comedy">Comedy</option>
                        <option value="cooking">Cooking</option>
                        <option value="culture">Culture</option>
                        <option value="diy">DIY</option>
                        <option value="education">Education</option>
                        <option value="entertainment">Entertainment</option>
                        <option value="fashion">Fashion</option>
                        <option value="finance">Finance</option>
                        <option value="fitness">Fitness</option>
                        <option value="food">Food</option>
                        <option value="gaming">Gaming</option>
                        <option value="health">Health</option>
                        <option value="history">History</option>
                        <option value="lifestyle">Lifestyle</option>
                        <option value="luxury">Luxury</option>
                        <option value="movies">Movies</option>
                        <option value="music">Music</option>
                        <option value="nature">Nature</option>
                        <option value="news">News</option>
                        <option value="outdoors">Outdoors</option>
                        <option value="parenting">Parenting</option>
                        <option value="pets">Pets</option>
                        <option value="photography">Photography</option>
                        <option value="politics">Politics</option>
                        <option value="realestate">Real Estate</option>
                        <option value="science">Science</option>
                        <option value="spirituality">Spirituality</option>
                        <option value="sports">Sports</option>
                        <option value="sustainability">Sustainability</option>
                        <option value="technology">Technology</option>
                        <option value="television">Television</option>
                        <option value="travel">Travel</option>
                        <option value="other">Other</option>
                    </select>
                    <button id="btnVerticalSave" class="btn btn-secondary edit-profile-save-btn" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Save" type="button"><i class="bi bi-save"></i></button>
                </div>

                <div id="profileColorsSection">
                    <label class="editLabel">theme colors</label>
                    <div class="profile-colors-grid">
                        <div class="color-picker-row">
                            <label for="colorPrimary">Primary</label>
                            <input type="color" id="colorPrimary" data-color-key="primary" value="#525252">
                        </div>
                        <div class="color-picker-row">
                            <label for="colorSecondary">Secondary</label>
                            <input type="color" id="colorSecondary" data-color-key="secondary" value="#414141">
                        </div>
                        <div class="color-picker-row">
                            <label for="colorTertiary">Tertiary</label>
                            <input type="color" id="colorTertiary" data-color-key="tertiary" value="#313131">
                        </div>
                        <div class="color-picker-row">
                            <label for="colorQuaternary">Accent</label>
                            <input type="color" id="colorQuaternary" data-color-key="quaternary" value="#3A7FD1">
                        </div>
                        <div class="color-picker-row">
                            <label for="colorText">Text</label>
                            <input type="color" id="colorText" data-color-key="text" value="#D3D3D3">
                        </div>
                        <div class="color-picker-row">
                            <label for="colorLink">Links</label>
                            <input type="color" id="colorLink" data-color-key="link" value="#3A7FD1">
                        </div>
                    </div>
                    <div class="color-actions">
                        <button type="button" class="btn btn-secondary" id="btnColorsReset">Reset</button>
                        <button type="button" class="btn" id="btnColorsSave">Save Colors</button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>{{end}}