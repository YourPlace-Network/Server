{{define "addSale"}}<div class="modal" id="addSaleModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body">
                <div class="form-group">
                    <label for="saleTitle">Product Title</label>
                    <input type="text" class="form-control" id="saleTitle" placeholder="Enter product title" maxlength="200">
                </div>
                <div class="form-group">
                    <label for="saleDescription">Description</label>
                    <textarea class="form-control" id="saleDescription" rows="4" placeholder="Describe your product..." maxlength="1000"></textarea>
                </div>
                <div class="form-group">
                    <label for="salePrice">Price (ETH)</label>
                    <input type="number" class="form-control" id="salePrice" placeholder="0.1" step="0.001" min="0">
                </div>
                <div class="container-fluid" id="addSaleControls">
                    <div class="row">
                        <div class="col" id="uploadImageColumn">
                            <button type="button" class="btn btn-secondary" id="btnUploadImage" data-bs-toggle="tooltip" title="Add product images">
                                <i class="bi bi-image" id="uploadImageBtnImg"></i> Add Images</button>
                            <input type="file" name="images" id="saleImages" multiple accept="image/*" hidden>
                        </div>
                        <div class="col" id="saveSaleColumn">
                            <div class="form-check form-switch" id="savedSaleCheckboxDiv" data-bs-toggle="tooltip" title="List this product on the blockchain">
                                <input class="form-check-input" type="checkbox" role="switch" id="savedSaleCheckbox" checked disabled>
                                <label class="form-check-label" for="savedSaleCheckbox" id="savedSaleCheckboxLabel">Blockchain Listing</label>
                            </div>
                        </div>
                        <div class="col" id="listColumn">
                            <div class="row justify-content-end" id="saleStatusRow">
                                <div id="saleStatusDiv">
                                    <p id="saleStatusText"></p>
                                </div>
                            </div>
                            <div class="row justify-content-end" id="listBtnRow">
                                <button type="button" class="btn btn-primary" id="submitSaleButton">List Product</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="saleImagesDiv" class="attachmentUploadGrid">
                </div>
            </div>
        </div>
    </div>
</div>
<button type="button" class="btn btn-primary grow" id="addSaleButton" data-bs-toggle="tooltip" title="List a Product" data-bs-placement="left">
    <i class="bi bi-currency-dollar"></i>
</button>{{end}}