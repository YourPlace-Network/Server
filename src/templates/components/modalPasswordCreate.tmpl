{{define "modalPasswordCreate"}}<div class="modal" id="modalPasswordCreate" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create Password</h5>
            </div>
            <div class="modal-body" id="modalPasswordCreateBody">
                <div class="mb-3">
                    <label for="passwordCreateInput" class="form-label">Password</label>
                    <input type="password" class="form-control" id="passwordCreateInput" placeholder="Enter password (min 7 characters)">
                </div>
                <div class="mb-3">
                    <label for="passwordCreateConfirmInput" class="form-label">Confirm Password</label>
                    <input type="password" class="form-control" id="passwordCreateConfirmInput" placeholder="Confirm password">
                </div>
                <div class="password-strength-container">
                    <div class="password-strength-bar">
                        <div class="password-strength-fill" id="passwordStrengthFill"></div>
                    </div>
                    <div class="password-strength-label" id="passwordStrengthLabel">Enter a password</div>
                </div>
                <div class="password-error" id="passwordCreateError"></div>
            </div>
            <div class="modal-footer" id="modalPasswordCreateFooter">
                <button type="button" class="btn btn-secondary" id="passwordCreateCancelBtn">Cancel</button>
                <button type="button" class="btn btn-primary" id="passwordCreateSubmitBtn" disabled>Create</button>
            </div>
        </div>
    </div>
</div>{{end}}
