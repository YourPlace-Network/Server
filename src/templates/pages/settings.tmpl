                                                            <button class="btn btn-primary btn-outline-secondary" id="defaultBaseURLBtn" type="button">Default</button>
                                                            <button class="btn btn-primary btn-outline-secondary" id="saveBaseURLBtn" type="button">Save</button>
                                                        </div>

                                                        <label for="baseThrottle" class="form-label throttleLabel" id="baseThrottleLabel">Server Throttle: <span id="baseThrottleNumber"></span> Requests-Per-Second</label>
                                                        <div class="input-group mb3">
                                                            <datalist id="baseThrottleMarkers">
                                                                <option value="0" label="0"></option>
                                                                <option value="10" label="10"></option>
                                                                <option value="50" label="50"></option>
                                                                <option value="100" label="100"></option>
                                                                <option value="250" label="250"></option>
                                                                <option value="500" label="500"></option>
                                                                <option value="1000" label="1000"></option>
                                                            </datalist>
                                                            <input type="range" class="form-range" id="baseThrottle" min="0" max="1000" step="5" value="0" list="baseThrottleMarkers">
                                                            <div id="baseThrottleTooltip" class="rangeTooltip" role="tooltip">
                                                                <div class="throttle-tooltip-inner"></div>
                                                                <div class="throttle-tooltip-arrow"></div>
                                                            </div>
                                                        </div>

                                                        <hr /><!-- ----------------------------------- -->
                                                        <div class="indexerProgressHeader">
                                                            <label for="baseIndexerProgress" class="form-label" id="baseIndexerProgressLabel">Indexer Progress:</label>
                                                            <span id="baseIndexerCachedPercent" class="indexerPercent">0%</span>
                                                        </div>
                                                        <div class="progress" id="baseIndexerProgressDiv">
                                                            <div id="baseIndexerProgressUncachedTail" class="progress-bar" role="progressbar" aria-valuenow="10" aria-valuemin="0" aria-valuemax="100"></div>
                                                            <div id="baseIndexerProgressCached" class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" aria-valuenow="80" aria-valuemin="0" aria-valuemax="100"></div>
                                                            <div id="baseIndexerProgressUncachedHead" class="progress-bar" role="progressbar" aria-valuenow="10" aria-valuemin="0" aria-valuemax="100"></div>
                                                        </div>
                                                        <div class="indexerStats" id="baseIndexerStats">
                                                            <span id="baseIndexerBlocksIndexed">0</span> / <span id="baseIndexerBlocksTotal">0</span> blocks
                                                        </div>

                                                        <div id="baseIndexerBtns" class="indexerBtns">
                                                            <button class="btn btn-primary" id="baseIndexerResetBtn">Reset</button>
                                                            <div class="dropdown indexerCatchUpDropdown">
                                                                <button class="btn btn-secondary dropdown-toggle" type="button" id="baseIndexerCatchUpBtn" data-bs-toggle="dropdown" aria-expanded="false">Catch-Up</button>
                                                                <ul class="dropdown-menu">
                                                                    <li><a class="dropdown-item" id="baseCatchUpFullBtn">Full</a></li>
                                                                    <li><hr class="dropdown-divider"></li>
                                                                    <li><a class="dropdown-item" id="baseCatchUpHelpBtn">Help<i class="bi bi-question-circle" id="baseIndexerCatchUpHelpIcon"></i></a></li>
                                                                </ul>
                                                            </div>
                                                        </div>

