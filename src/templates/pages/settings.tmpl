                                                                <option value="1000" label="1000"></option>
                                                            </datalist>
                                                            <input type="range" class="form-range" id="ethereumThrottle" min="0" max="1000" step="5" value="0" list="ethereumThrottleMarkers">
                                                            <div id="ethereumThrottleTooltip" class="rangeTooltip" role="tooltip">
                                                                <div class="throttle-tooltip-inner"></div>
                                                                <div class="throttle-tooltip-arrow"></div>
                                                            </div>
                                                        </div>

                                                        <hr /><!-- ----------------------------------- -->
                                                        <div class="indexerProgressHeader">
                                                            <label for="ethereumIndexerProgress" class="form-label" id="ethereumIndexerProgressLabel">Indexer Progress:</label>
                                                            <span id="ethereumIndexerCachedPercent" class="indexerPercent">0%</span>
                                                        </div>
                                                        <div class="progress" id="ethereumIndexerProgressDiv">
                                                            <div id="ethereumIndexerProgressUncachedTail" class="progress-bar" role="progressbar" aria-valuenow="10" aria-valuemin="0" aria-valuemax="100"></div>
                                                            <div id="ethereumIndexerProgressCached" class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" aria-valuenow="80" aria-valuemin="0" aria-valuemax="100"></div>
                                                            <div id="ethereumIndexerProgressUncachedHead" class="progress-bar" role="progressbar" aria-valuenow="10" aria-valuemin="0" aria-valuemax="100"></div>
                                                        </div>
                                                        <div class="indexerStats" id="ethereumIndexerStats">
                                                            <span id="ethereumIndexerBlocksIndexed">0</span> / <span id="ethereumIndexerBlocksTotal">0</span> blocks
                                                        </div>

                                                        <div id="ethereumIndexerBtns" class="indexerBtns">
                                                            <button class="btn btn-primary" id="ethereumIndexerResetBtn">Reset</button>
                                                            <div class="dropdown indexerCatchUpDropdown">
                                                                <button class="btn btn-secondary dropdown-toggle" type="button" id="ethereumIndexerCatchUpBtn" data-bs-toggle="dropdown" aria-expanded="false">Catch-Up</button>
                                                                <ul class="dropdown-menu">
                                                                    <li><a class="dropdown-item" id="ethereumCatchUpFullBtn">Full</a></li>
                                                                    <li><hr class="dropdown-divider"></li>
                                                                    <li><a class="dropdown-item" id="ethereumCatchUpHelpBtn">Help<i class="bi bi-question-circle" id="ethereumIndexerCatchUpHelpIcon"></i></a></li>
                                                                </ul>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Solana -->
                                <div class="row">
                                    <div class="col-12 centerColumn">
                                        <div class="accordion accordion-flush" id="solanaAccordion">
                                            <div class="accordion-item">
                                                <h2 class="accordion-header" id="headingSolana">
                                                    <button class="accordion-button button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSolana" aria-expanded="false" aria-controls="collapseSolana" disabled>
                                                        <img src="/static/image/solana.svg" class="settingsBlockchainImg" alt=""><b>Solana (Coming Soon)</b>
                                                    </button>
                                                </h2>
                                                <div id="collapseSolana" class="accordion-collapse collapse" aria-labelledby="headingSolana" data-bs-parent="#solanaAccordion">
                                                    <div class="accordion-body">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>


                            </div>
                        </div>
                    </div>
                    <!-- Services -->
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingServices">
                            <button class="accordion-button button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseServices" aria-expanded="false" aria-controls="collapseServices">
                                <i class="bi bi-globe"></i><b>Services</b>
                            </button>
                        </h2>
                        <div id="collapseServices" class="accordion-collapse collapse" aria-labelledby="headingServices" data-bs-parent="#settingsAccordion">
                            <div class="accordion-body">
                                <div class="accordion accordion-flush" id="servicesAccordion">
                                    <!-- X.com -->
                                    <div class="accordion-item">
                                        <h2 class="accordion-header" id="headingXcom">
                                            <button class="accordion-button button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseXcom" aria-expanded="false" aria-controls="collapseXcom">
                                                <img src="/static/image/x.svg" class="settingsServiceImg" alt=""><b>X.com</b>
                                            </button>
                                        </h2>
                                        <div id="collapseXcom" class="accordion-collapse collapse" aria-labelledby="headingXcom" data-bs-parent="#servicesAccordion">
                                            <div class="accordion-body">
                                                <div class="form-check form-switch" id="xcomCrossPostSwitch">
                                                    <input class="form-check-input" type="checkbox" role="switch" id="xcomCrossPostCheckbox">
                                                    <label class="form-check-label" for="xcomCrossPostCheckbox">Enable Cross-Post <i class="bi bi-question-circle" data-bs-toggle="tooltip" data-bs-placement="right" data-bs-custom-class="yp-tooltip" title="Automatically post your YourPlace posts to X.com"></i></label>
                                                </div>
                                                <div class="form-check form-switch" id="xcomFeedAggregationSwitch">
                                                    <input class="form-check-input" type="checkbox" role="switch" id="xcomFeedAggregationCheckbox">
                                                    <label class="form-check-label" for="xcomFeedAggregationCheckbox">Enable Feed Aggregation <i class="bi bi-question-circle" data-bs-toggle="tooltip" data-bs-placement="right" data-bs-custom-class="yp-tooltip" title="Display your X.com timeline posts in your YourPlace feed"></i></label>
                                                </div>
                                                <hr>
                                                <div id="xcomCredentialsDiv">
                                                    <p class="xcomDescription"><div id="xcomStatusLight" class="serviceStatusLight redLight" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-custom-class="yp-tooltip" data-bs-title="API credentials not configured"></div>API Credentials</p>
                                                    <input type="text" class="form-control mb-2" id="xcomApiKey" placeholder="API Key">
                                                    <input type="password" class="form-control mb-2" id="xcomApiSecret" placeholder="API Secret">
                                                    <input type="text" class="form-control mb-2" id="xcomAccessToken" placeholder="Access Token">
                                                    <input type="password" class="form-control mb-2" id="xcomAccessTokenSecret" placeholder="Access Token Secret">
                                                    <div id="xcomCredentialsBtns">
                                                        <button class="btn btn-primary" id="saveXcomCredentialsBtn">Save</button>
                                                        <button class="btn btn-primary" id="removeXcomCredentialsBtn">Remove</button>
                                                        <button class="btn btn-primary btn-outline-secondary" id="testXcomCredentialsBtn">Test</button>
                                                    </div>
                                                </div>
                                                <div id="xcomScrapeCredentialsDiv" style="display: none;">
                                                    <hr>
                                                    <p class="xcomDescription"><div id="xcomScrapeStatusLight" class="serviceStatusLight redLight" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-custom-class="yp-tooltip" data-bs-title="Login credentials not configured"></div>Login Credentials (for feed aggregation on Free tier)</p>
                                                    <input type="email" class="form-control mb-2" id="xcomScrapeEmail" placeholder="Email">
                                                    <input type="text" class="form-control mb-2" id="xcomScrapeUsername" placeholder="Username (without @)">
                                                    <input type="password" class="form-control mb-2" id="xcomScrapePassword" placeholder="Password">
                                                    <div id="xcomScrapeCredentialsBtns">
                                                        <button class="btn btn-primary" id="saveXcomScrapeCredentialsBtn">Save</button>
                                                        <button class="btn btn-primary" id="removeXcomScrapeCredentialsBtn">Remove</button>
                                                        <button class="btn btn-primary btn-outline-secondary" id="testXcomScrapeCredentialsBtn">Test</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Server Info -->
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingServerInfo">
                            <button class="accordion-button button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseServerInfo" aria-expanded="false" aria-controls="collapseServerInfo">
                                <i class="bi bi-info-circle"></i><b><span>Server Info</span></b>
                            </button>
                        </h2>
                        <div id="collapseServerInfo" class="accordion-collapse collapse" aria-labelledby="headingServerInfo" data-bs-parent="#settingsAccordion">
                            <div class="accordion-body" id="serverInfoAccordionBody">
                                <div class="container">
                                    <div class="row">
                                        <div id="switchCol" class="col">
                                            <div class="form-check form-switch" id="serverDebugMode">
                                                <input class="form-check-input" type="checkbox" role="switch" id="serverDebugModeCheckbox">
                                                <label class="form-check-label" for="serverDebugModeCheckbox">Debug Mode</label>
                                            </div>
                                        </div>

                                        <div id="serverUpdateDiv" class="col">
                                            <button class="btn btn-primary btn-outline-secondary" id="serverUpdateBtn" type="button"><i class="bi bi-cloud-download"></i><span>Check For Updates</span></button>
                                            <button class="btn btn-primary btn-outline-secondary" id="serverUninstallBtn" type="button"><i class="bi bi-trash"></i><span>Uninstall</span></button>
                                        </div>

                                        <div id="versionCol" class="col">
                                            <div id="serverVersionDiv">
                                                <span id="serverVersionLabel">Server Version:</span>
                                                <span id="serverVersionText">?</span>
                                            </div>
                                            <div id="helperVersionDiv">
                                                <span id="helperVersionLabel">Helper Version:</span>
                                                <span id="helperVersionText">?</span>
                                            </div>
                                        </div>
                                    </div>

                                    <hr>

                                    <div class="row" id="runtimeInfoRow">
                                        <div class="col">
                                            <div id="runtimeFlagsDiv">
                                                <span id="runtimeFlagsLabel"><b>Command Line Flags:</b></span>
                                                <span id="runtimeFlagsText"></span>
                                            </div>
                                            <div id="runtimeEnvVarsDiv">
                                                <span id="runtimeEnvVarsLabel"><b>Environment Variables:</b></span>
                                                <div id="runtimeEnvVarsText"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <hr>

                                    <div class="row align-items-start">
                                        <div id="logsDiv">
                                            <button class="btn btn-primary btn-outline-secondary" id="serverLogsViewBtn" type="button">Server Logs</button>
                                            <button class="btn btn-primary btn-outline-secondary" id="helperLogsViewBtn" type="button">Helper Logs</button>
                                            <div id="logsView" class="hidden"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-1"></div>
        </div>
    </div>
    {{template "footer" .}}
    <!-- Injected Variables -->
    <input type="hidden" id="csrfToken" value="{{ .csrfToken }}">
    <input type="hidden" id="isCookieAuthenticated" value="{{ .isCookieAuthenticated }}">
</body>
</html>