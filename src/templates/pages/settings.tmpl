                                                        <label class="form-label" for="postHistoryDays" id="postHistoryDaysLabel">Post History To Keep (days)</label>
                                                        <div class="input-group mb3">
                                                            <input type="number" class="form-control" id="postHistoryDays" placeholder="Days" min="1" max="365" step="1" data-bind="value:postHistoryDays" />
                                                            <button class="btn btn-primary" id="savePostHistoryDaysBtn">Save</button>
                                                        </div>-->
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Ethereum -->
                                <div class="row">
                                    <div class="col-12 centerColumn">
                                        <div class="accordion accordion-flush" id="ethereumAccordion">
                                            <div class="accordion-item">
                                                <h2 class="accordion-header" id="headingEthereum">
                                                    <button class="accordion-button button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseEthereum" aria-expanded="false" aria-controls="collapseEthereum">
                                                        <img src="/static/image/ethereum.svg" class="settingsBlockchainImg" alt=""><b>Ethereum</b>
                                                    </button>
                                                </h2>
                                                <div id="collapseEthereum" class="accordion-collapse collapse" aria-labelledby="headingEthereum" data-bs-parent="#ethereumAccordion">
                                                    <div class="accordion-body">
