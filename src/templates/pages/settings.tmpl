                                                            <label class="form-check-label" for="baseIndexerRunCheckbox">Run Indexer</label>
                                                            <div id="baseIndexerStatusLight" class="indexerStatusLight redLight" data-bs-toggle="tooltip" data-bs-placement="right" data-bs-custom-class="yp-tooltip" data-bs-title="Base indexer stopped"></div>
                                                        </div>
                                                        <div id="baseFullNodeDiv">
