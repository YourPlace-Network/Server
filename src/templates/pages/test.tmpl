{{template "header" .}}
<body class="body">
    <div class="container-fluid vh-100">
        <div class="row" id="row1">
            <div class="col-sm-1"></div>
            <div class="col-sm-10">

                <div id="editAvatar">
                    <label class="editLabel btn" for="inputAvatar">Upload Avatar</label>
                    <input type="file" class="form-control" id="inputAvatar" accept="image/png,image/jpeg,image/svg+xml,image/webp,image/gif"/>
                    <img id="avatarPreview" class="previewImg" src="/static/image/avatar.svg" alt="avatar preview" crossorigin="anonymous" referrerpolicy="no-referrer">
                </div>

            </div>
            <div class="col-sm-1">
                {{template "htmlMenu" .}}
                {{template "addPost" .}}
            </div>
        </div>
    </div>
    <input type="hidden" id="csrfToken" value="{{ .csrfToken }}">
</body>
</html>
